# Copy to .env.local and fill in. Never commit .env.local.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used ONLY to store public form submissions (enquiries).
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, no trailing slash. Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://srirangacharitabletrust.org

# Random string (e.g. `openssl rand -hex 32`). Salts IP hashes used for form rate limiting.
ENQUIRY_IP_SALT=change-me

# Random string. Vercel sends it as a Bearer token to the keep-alive cron.
CRON_SECRET=change-me
